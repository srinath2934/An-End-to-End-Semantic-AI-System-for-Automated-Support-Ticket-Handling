# Environment variables used by the project
# Copy this file to `.env` in the repo root and fill values before running.

# Path or URL to the saved PyTorch model (local path or s3:// URL)
MODEL_PATH=models/multitask_model.pt

# Path to FAISS index file
FAISS_INDEX_PATH=models/faiss.index

# Optional: Weights & Biases API key for experiment tracking
WANDB_API_KEY=

# Database/analytics connection (sqlite, postgres, or a URL)
DATABASE_URL=sqlite:///./data/predictions.db

# Server host & port (used by run scripts)
HOST=0.0.0.0
PORT=8000

# Optional storage for large artifacts
ARTIFACT_STORE_URL=
